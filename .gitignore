# Godot 4 editor / import cache — regenerated on every open, never committed.
.godot/
*.translation

# Export output
builds/
*.exe
*.pck
*.zip

# Python test runner bytecode (including research tooling)
__pycache__/

# Local scratch
*.tmp
*.log
.DS_Store
Thumbs.db

# Runtime user data accidentally copied in
runtime.log

# godot-bridge injects this autoload on demand and rewrites project.godot with it.
# It is a dev tool: it must never ship in an export, so it stays out of the tree.
autoload/

# tools/strip_dev_autoload.py parks the dev autoload line here while an export runs
tools/.dev_autoload.bak

# Screenshots taken through the interaction server during a run.
shots/

# Reference stills under visual/preview/ are imported by every export/editor open,
# which spawns an .import sidecar next to each PNG. The stills are committed; the
# sidecars are regenerated on demand and would otherwise dirty the tree constantly.
visual/preview/*.import
