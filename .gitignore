# Godot 4 editor / import cache — regenerated on every open, never committed.
.godot/
*.translation

# Export output
builds/
*.exe
*.pck
*.zip

# Local scratch
*.tmp
*.log
.DS_Store
Thumbs.db

# Runtime user data accidentally copied in
runtime.log

# godot-bridge injects this autoload on demand and rewrites project.godot with it.
# It is a dev tool: it must never ship in an export, so it stays out of the tree.
autoload/

# Screenshots taken through the interaction server during a run.
shots/
