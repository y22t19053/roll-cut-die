; Engine configuration file.
; roll cut die — Godot 4.3
; Input actions are created at runtime by scripts/core/input_setup.gd (not stored here),
; so the input map has exactly one source of truth and is testable in headless mode.

config_version=5

[application]

config/name="roll cut die"
run/main_scene="res://scenes/front/title.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

GameSession="*res://scripts/core/game_session.gd"

[debug]

gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/RCD-Noto.otf"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=0.0

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.055, 0.06, 0.07, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
